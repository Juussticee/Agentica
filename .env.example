# Agentica configuration.
# Copy this file to .env (in the project root) and edit it. NEVER commit .env —
# it is git-ignored. Keys not set here fall back to the defaults in app/config.py.

# --- AI provider -----------------------------------------------------------
# "gemini" (Google API, needs a key) or "ollama" (self-hosted, no key).
# NOTE: if LLM_PROVIDER is unset, the default is "gemini" — set it explicitly
# if you want Ollama.
# LLM_PROVIDER=ollama

# Gemini settings (used when LLM_PROVIDER=gemini).
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3-flash-preview

# Ollama settings (used when LLM_PROVIDER=ollama). Small, CPU-friendly model:
# ollama pull qwen3:0.6b — larger models need more RAM/VRAM.
# OLLAMA_BASE_URL=http://localhost:11434
# MAIN_MODEL=qwen3:0.6b
# FALLBACK_MODEL=qwen2.5:3b-instruct

# --- Services ---------------------------------------------------------------
# Local SearXNG web-search container (host port 8888 -> container 8080 by
# default on this project's setup). Optional — research degrades gracefully
# without it.
# SEARXNG_URL=http://localhost:8888

# --- Supervisor routing (Phase 6) -------------------------------------------
# "keyword" (default, deterministic, never needs AI) or "llm" (opt-in LLM
# classification with deterministic fallback on any error).
# ROUTING_MODE=keyword

# --- Planner (Phase 7) -------------------------------------------------------
# "auto" (default: plan only complex requests), "off" (planner disabled),
# "always" (debug/testing only).
# PLANNER_MODE=auto
# MAX_PLAN_TASKS=6

# --- ERP boundary (Phase 3) ---------------------------------------------------
# Only "mock" ships today: deterministic, read-only, fictional records.
# ERP_ADAPTER=mock
